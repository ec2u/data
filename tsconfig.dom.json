{
  // the DOM-dependent modules, compiled on their own so that the DOM typings jsdom drags in stay out of the main
  // program: the main program consumes the declarations emitted here, which report DOM-free types only
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "lib/.dom.tsbuildinfo",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "files": [
    "src/pages/_scraper.ts"
  ]
}
