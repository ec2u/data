{
  "/units/": {
    "get": {
      "summary": "List units",
      "description": "List units with optional query parameters for filtering",
      "tags": [
        "units"
      ],
      "parameters": [
        {
          "name": "updated",
          "in": "query",
          "description": "Filter by update timestamp (milliseconds from epoch)",
          "schema": {
            "type": "integer"
          }
        },
        {
          "name": "university",
          "in": "query",
          "description": "Filter by university IRI (absolute IRI of the university)",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "offset",
          "in": "query",
          "description": "Pagination offset",
          "schema": {
            "type": "integer",
            "minimum": 0
          }
        },
        {
          "name": "limit",
          "in": "query",
          "description": "Maximum number of results",
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Successful response"
        }
      }
    }
  },
  "/units/{code}": {
    "get": {
      "summary": "Retrieve a unit by code",
      "description": "Retrieve a specific unit by its code identifier",
      "tags": [
        "units"
      ],
      "parameters": [
        {
          "name": "code",
          "in": "path",
          "required": true,
          "description": "The unit identifier",
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Successful response"
        },
        "404": {
          "description": "Unit not found"
        }
      }
    }
  }
}
