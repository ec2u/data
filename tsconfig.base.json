{
  "compilerOptions": {
    "baseUrl": "src",
    "rootDir": "src",
    "outDir": "lib",
    "paths": {
      "@/*": [
        "*"
      ]
    },
    "strict": true,
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "sourceMap": true,
    "skipLibCheck": true
  },
  // shared options only: without an empty file set the config would implicitly claim every source under its directory,
  // and an IDE checking a module against it would type the whole tree against the DOM typings jsdom drags in
  "files": [],
  "include": []
}
