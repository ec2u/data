{
  "compilerOptions": {
    "baseUrl": "src",
    "rootDir": "src",
    "outDir": "lib",
    "paths": {
      "@/*": [
        "*"
      ]
    },
    "strict": true,
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    // the project runs on Node: only its typings are laid in, so that a package shipping a DOM reference doesn't
    // shadow them for the whole compilation unit
    "types": [
      "node"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "sourceMap": true,
    "skipLibCheck": true
  }
}
