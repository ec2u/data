{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "DOM.AsyncIterable"
    ],
    "types": [
      "node"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "customConditions": [
      "@ec2u/source",
      "@metreeca/source"
    ],
    "noEmit": true
  },
  "include": [
    "*.ts",
    "packages/*/src"
  ],
  "exclude": [
    "packages/client"
  ]
}
