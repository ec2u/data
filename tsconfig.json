{
  "compilerOptions": {
    "baseUrl": "src",
    "outDir": "lib",
    "paths": {
      "@/*": [
        "*"
      ]
    },
    "strict": true,
    "target": "ES2022",
    "lib": [
      "ES2022",
      "ESNext"
    ],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "sourceMap": true,
    "skipLibCheck": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "**/*.*.ts"
  ]
}
