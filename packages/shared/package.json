{
  "private": true,
  "name": "@ec2u/data-shared",
  "description": "Knowledge Hub shared data models",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@ec2u/source": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./*.js": {
      "@ec2u/source": "./src/*.ts",
      "default": "./lib/*.js"
    },
    "./*.json": {
      "@ec2u/source": "./src/*.json",
      "default": "./lib/*.json"
    }
  },
  "dependencies": {
    "@grafctory/blue": "^0.16.0",
    "@grafctory/core": "^0.14.3",
    "@grafctory/qest": "^0.15.2",
    "@kxta/open": "*",
    "uuid": "^14.0.1"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json"
  }
}
