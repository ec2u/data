{
  "name": "@ec2u/data-shared",
  "version": "0.0.0",
  "description": "Data model shared between the endpoints and their clients",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@ec2u/source": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./*.js": {
      "@ec2u/source": "./src/*.ts",
      "default": "./lib/*.js"
    }
  },
  "dependencies": {
    "@metreeca/blue": "^0.10.0",
    "@metreeca/core": "^0.10.0",
    "@metreeca/qest": "^0.10.0",
    "uuid": "^14.0.1"
  }
}
