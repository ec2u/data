{
  "name": "@ec2u/data-server",
  "version": "0.0.0",
  "description": "HTTP endpoints exposing the ingested Knowledge Hub datasets",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@ec2u/source": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./*.js": {
      "@ec2u/source": "./src/*.ts",
      "default": "./lib/*.js"
    }
  },
  "dependencies": {
    "@ec2u/data-loader": "*",
    "@metreeca/http": "^0.2.0",
    "@metreeca/tape": "^0.10.1",
    "@metreeca/work": "*",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6"
  }
}
