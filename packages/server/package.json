{
  "name": "@ec2u/data-server",
  "version": "0.0.0",
  "description": "Knowledge Hub data server",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./*.js": {
      "@ec2u/source": "./src/*.ts",
      "default": "./lib/*.js"
    }
  },
  "scripts": {
    "serve": "tsx --conditions=@ec2u/source --tsconfig ../../tsconfig.json --watch src/index.ts"
  },
  "dependencies": {
    "@ec2u/data-loader": "*",
    "@metreeca/http": "^0.2.0",
    "@metreeca/tape": "^0.10.1",
    "@metreeca/work": "*",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6"
  }
}
