{
  "name": "@ec2u/data-client",
  "version": "0.0.0",
  "description": "Typed client for the Knowledge Hub data endpoints",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@ec2u/source": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./*.js": {
      "@ec2u/source": "./src/*.ts",
      "default": "./lib/*.js"
    }
  }
}
