  "dependencies": {
    "@metreeca/gear": "^0.3.0",
    "@metreeca/http": "^0.4.0",
    "@metreeca/keep-sparql": "^0.11.0",
    "@metreeca/wire-sparql-rdf4j": "^0.11.1",
    "@metreeca/work": "*"
  }
}
