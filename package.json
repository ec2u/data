{
  "name": "@ec2u/data",
  "version": "0.0.0",
  "description": "AI-based data ingestion pipelines for the EC2U Knowledge Hub",
  "homepage": "https://github.com/ec2u/pipe",
  "bugs": "https://github.com/ec2u/pipe/issues",
  "license": "Apache-2.0",
  "author": "EC2U Alliance",
  "repository": "github:ec2u/pipe",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "clean": "rm -rf packages/*/lib node_modules",
    "prime": "npm ci && sh package.sh --gcp",
    "setup": "npm ci && sh package.sh --gcp --link",
    "build": "rm -rf packages/*/lib && tsc --build tsconfig.build.json && cpy 'src/**/*.sys.md' lib --cwd=packages/loader",
    "check": "npx vitest run",
    "serve": "npx tsx --conditions=@ec2u/source --tsconfig packages/server/tsconfig.json --watch packages/server/src/index.ts"
  },
  "devDependencies": {
    "cpy-cli": "^7.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "@google/genai@1.52.0": true,
    "@scarf/scarf@1.4.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.5": true
  }
}
