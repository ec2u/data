{
  "name": "@ec2u/data",
  "version": "0.0.0",
  "description": "AI-based data ingestion pipelines for the EC2U Knowledge Hub",
  "homepage": "https://github.com/ec2u/pipe",
  "bugs": "https://github.com/ec2u/pipe/issues",
  "license": "Apache-2.0",
  "author": "EC2U Alliance",
  "repository": "github:ec2u/pipe",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "clean": "rm -rf packages/*/lib packages/*/node_modules node_modules",
    "prime": "npm ci && sh package.sh --gcp",
    "setup": "npm ci && sh package.sh --gcp --link",
    "build": "rm -rf packages/*/lib && tsc --build tsconfig.build.json && npm run build --workspaces --if-present",
    "check": "npx vitest run",
    "serve": "concurrently --names server,client npm:serve:server npm:serve:client",
    "serve:server": "npm run serve --workspace=@ec2u/data-server",
    "serve:client": "wait-on tcp:8080 && npm run serve --workspace=@ec2u/data-client"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  },
  "allowScripts": {
    "@google/genai@1.52.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.6": true
  }
}
